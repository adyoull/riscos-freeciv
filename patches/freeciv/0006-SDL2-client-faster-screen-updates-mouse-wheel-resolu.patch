+/**********************************************************************//**
+  The mouse wheel over a dialog with a scrolled list (an advanced dialog
+  with the standard scroll buttons): scroll the list by 'rows' rows
+  (negative: up), as the up and down buttons do. Returns TRUE if a list
+  under the pointer was found.
+**************************************************************************/
+bool wheel_scroll_advanced_dialog(int x, int y, int rows)
+{
+  struct widget *pwidget;
+
+  for (pwidget = main_widget_list_first(); pwidget != NULL;
+       pwidget = pwidget->next) {
+    struct advanced_dialog *dlg;
+    struct widget *window;
+    SDL_Rect area;
+
+    /* Only the standard up buttons are known to carry an advanced dialog */
+    if (pwidget->action != std_up_advanced_dlg_callback) {
+      continue;
+    }
+    dlg = pwidget->private_data.adv_dlg;
+    if (dlg == NULL || dlg->scroll == NULL || dlg->end_widget_list == NULL
+        || dlg->active_widget_list == NULL
+        || (get_wflags(pwidget) & WF_HIDDEN)) {
+      continue;
+    }
+    window = dlg->end_widget_list;
+    area = (SDL_Rect){window->dst->dest_rect.x + window->size.x,
+                      window->dst->dest_rect.y + window->size.y,
+                      window->size.w, window->size.h};
+    if (!is_in_rect_area(x, y, &area)) {
+      continue;
+    }
+
+    /* The widget under the pointer (and its info label) moves away */
+    unselect_widget_action();
+
+    if (rows > 0) {
+      struct UP_DOWN down;
+      struct widget *end = dlg->active_widget_list;
+      int n = dlg->scroll->active * dlg->scroll->step - 1;
+
+      while (n-- > 0 && end->prev != NULL) {
+        end = end->prev;
+      }
+      down.step = get_step(dlg->scroll);
+      down.begin = dlg->active_widget_list;
+      down.end = end;
+      down.begin_widget_list = dlg->begin_active_widget_list;
+      down.end_widget_list = dlg->end_active_widget_list;
+      down.vscroll = dlg->scroll;
+      while (rows-- > 0) {
+        inside_scroll_down_loop(&down);
+      }
+      dlg->active_widget_list = down.begin;
+    } else {
+      struct UP_DOWN up;
+
+      up.step = get_step(dlg->scroll);
+      up.begin = dlg->active_widget_list;
+      up.begin_widget_list = dlg->begin_active_widget_list;
+      up.end_widget_list = dlg->end_active_widget_list;
+      up.vscroll = dlg->scroll;
+      while (rows++ < 0) {
+        inside_scroll_up_loop(&up);
+      }
+      dlg->active_widget_list = up.begin;
+    }
+
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
