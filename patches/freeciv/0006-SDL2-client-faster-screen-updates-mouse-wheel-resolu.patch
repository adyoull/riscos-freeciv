diff --git a/client/gui-sdl2/graphics.c b/client/gui-sdl2/graphics.c
index 79a1267..36fca18 100644
--- a/client/gui-sdl2/graphics.c
+++ b/client/gui-sdl2/graphics.c
@@ -52,12 +52,77 @@
 
 /* ------------------------------ */
 
+/* DIRECT_PRESENT: copy the changed parts of the main surface straight into
+ * the window's framebuffer instead of a texture and renderer. Always on
+ * RISC OS; -DFREECIV_SDL2_DIRECT_PRESENT turns it on elsewhere (for
+ * testing it on other systems). */
+#if defined(FREECIV_RISCOS) || defined(FREECIV_SDL2_DIRECT_PRESENT)
+#define DIRECT_PRESENT
+#endif
+
 struct sdl2_data main_data;
 
 static SDL_Surface *main_surface = NULL;
 
 static bool render_dirty = TRUE;
 
+#ifdef DIRECT_PRESENT
+/* The main surface is copied straight into the window's
+ * framebuffer (SDL_GetWindowSurface), and only the parts that changed are
+ * copied and shown. Upstream uploads the whole screen to a texture and
+ * copies all of it through a software renderer for every update, even
+ * for a mouse pointer or a button, which on a RISC OS machine (software
+ * rendering, then a sprite plot for every update) costs a whole-window
+ * redraw each time. */
+#define PRESENT_RECT_LIMIT 32
+static SDL_Rect present_rects[PRESENT_RECT_LIMIT];
+static int present_count = 0;
+static bool present_all = TRUE;
+
+/* Statistics for the log (see direct_present_stats()) */
+static Uint32 stat_updates = 0;
+static Uint64 stat_pixels = 0;
+static Uint64 stat_ticks = 0;
+
+/**********************************************************************//**
+  Updates shown, pixels copied and time spent (ms) since the last call.
+**************************************************************************/
+void direct_present_stats(Uint32 *updates, Uint64 *pixels, double *ms)
+{
+  *updates = stat_updates;
+  *pixels = stat_pixels;
+  *ms = stat_ticks * 1000.0 / SDL_GetPerformanceFrequency();
+  stat_updates = 0;
+  stat_pixels = 0;
+  stat_ticks = 0;
+}
+
+/**********************************************************************//**
+  Remember a changed part of the main surface.
+**************************************************************************/
+static void present_add(const SDL_Rect *r)
+{
+  if (present_all || r->w <= 0 || r->h <= 0) {
+    return;
+  }
+  if (present_count == PRESENT_RECT_LIMIT) {
+    /* Too many to show one by one: show their bounding box. */
+    int i, x0 = r->x, y0 = r->y, x1 = r->x + r->w, y1 = r->y + r->h;
+
+    for (i = 0; i < present_count; i++) {
+      x0 = MIN(x0, present_rects[i].x);
+      y0 = MIN(y0, present_rects[i].y);
+      x1 = MAX(x1, present_rects[i].x + present_rects[i].w);
+      y1 = MAX(y1, present_rects[i].y + present_rects[i].h);
+    }
+    present_rects[0] = (SDL_Rect){x0, y0, x1 - x0, y1 - y0};
+    present_count = 1;
+    return;
+  }
+  present_rects[present_count++] = *r;
+}
+#endif /* DIRECT_PRESENT */
+
 /**********************************************************************//**
   Allocate new gui_layer.
 **************************************************************************/
@@ -223,7 +288,20 @@ int screen_blit(SDL_Surface *src, SDL_Rect *srcrect, SDL_Rect *dstrect,
 {
   render_dirty = TRUE;
 
+#ifdef DIRECT_PRESENT
+  {
+    /* SDL_BlitSurface() leaves the clipped destination in the rect */
+    SDL_Rect whole = {0, 0, 0, 0};
+    SDL_Rect *dst = (dstrect != NULL) ? dstrect : &whole;
+    int ret = alphablit(src, srcrect, main_surface, dst, alpha_mod);
+
+    present_add(dst);
+
+    return ret;
+  }
+#else  /* DIRECT_PRESENT */
   return alphablit(src, srcrect, main_surface, dstrect, alpha_mod);
+#endif /* DIRECT_PRESENT */
 }
 
 /**********************************************************************//**
@@ -540,6 +618,9 @@ void init_sdl(int flags)
 **************************************************************************/
 static void free_surfaces(void)
 {
+#ifdef DIRECT_PRESENT
+  FREESURFACE(main_surface);
+#endif
   if (main_data.renderer != NULL) {
     SDL_DestroyRenderer(main_data.renderer);
     main_data.renderer = NULL;
@@ -553,10 +634,44 @@ static void free_surfaces(void)
 **************************************************************************/
 bool create_surfaces(int width, int height)
 {
+#ifndef DIRECT_PRESENT
   unsigned flags;
+#endif
 
   free_surfaces();
 
+#ifdef DIRECT_PRESENT
+  {
+    /* The main surface gets the window framebuffer's colour order (plus
+     * alpha: create_surf() and friends copy its format, and sprites need
+     * alpha), so presenting is a plain copy. */
+    SDL_Surface *ws = SDL_GetWindowSurface(main_data.screen);
+    Uint32 rm = 0x000000FF, gm = 0x0000FF00, bm = 0x00FF0000;
+
+    if (ws == NULL) {
+      log_fatal(_("Failed to get the window surface: %s"), SDL_GetError());
+      return FALSE;
+    }
+    if (ws->format->BytesPerPixel == 4) {
+      rm = ws->format->Rmask;
+      gm = ws->format->Gmask;
+      bm = ws->format->Bmask;
+    }
+    main_surface = SDL_CreateRGBSurface(0, width, height, 32,
+                                        rm, gm, bm, ~(rm | gm | bm));
+    FREESURFACE(main_data.map);
+    main_data.map = SDL_CreateRGBSurface(0, width, height, 32,
+                                         rm, gm, bm, ~(rm | gm | bm));
+    if (main_surface == NULL || main_data.map == NULL) {
+      log_fatal(_("Failed to create RGB surface: %s"), SDL_GetError());
+      return FALSE;
+    }
+    main_data.renderer = NULL;
+    main_data.maintext = NULL;
+    present_all = TRUE;
+    render_dirty = TRUE;
+  }
+#else  /* DIRECT_PRESENT */
   if (is_bigendian()) {
     main_surface = SDL_CreateRGBSurface(0, width, height, 32,
                                         0x0000FF00, 0x00FF0000,
@@ -601,6 +716,7 @@ bool create_surfaces(int width, int height)
     log_fatal(_("Failed to create texture: %s"), SDL_GetError());
     return FALSE;
   }
+#endif /* DIRECT_PRESENT */
 
   if (main_data.gui) {
     FREESURFACE(main_data.gui->surface);
@@ -666,6 +782,47 @@ bool set_video_mode(unsigned width, unsigned height, unsigned flags_in)
 **************************************************************************/
 void update_main_screen(void)
 {
+#ifdef DIRECT_PRESENT
+  if (render_dirty) {
+    SDL_Surface *ws = SDL_GetWindowSurface(main_data.screen);
+    SDL_BlendMode mode;
+    Uint64 t0 = SDL_GetPerformanceCounter();
+    int i;
+
+    if (ws == NULL) {
+      return;
+    }
+    /* A copy, not a blend (as upstream's texture upload) */
+    SDL_GetSurfaceBlendMode(main_surface, &mode);
+    SDL_SetSurfaceBlendMode(main_surface, SDL_BLENDMODE_NONE);
+    SDL_SetSurfaceAlphaMod(main_surface, 255);
+    if (present_all || ws->w != main_surface->w || ws->h != main_surface->h) {
+      SDL_BlitSurface(main_surface, NULL, ws, NULL);
+      SDL_UpdateWindowSurface(main_data.screen);
+      stat_pixels += (Uint64) ws->w * ws->h;
+    } else {
+      for (i = 0; i < present_count; i++) {
+        SDL_Rect r = present_rects[i];
+
+        SDL_BlitSurface(main_surface, &present_rects[i], ws, &r);
+        present_rects[i] = r;
+        stat_pixels += (Uint64) r.w * r.h;
+      }
+      if (present_count > 0) {
+        SDL_UpdateWindowSurfaceRects(main_data.screen, present_rects,
+                                     present_count);
+      }
+    }
+    SDL_SetSurfaceBlendMode(main_surface, mode);
+    present_count = 0;
+    present_all = FALSE;
+    render_dirty = FALSE;
+    stat_updates++;
+    stat_ticks += SDL_GetPerformanceCounter() - t0;
+  }
+  return;
+#endif /* DIRECT_PRESENT */
+
   if (render_dirty) {
     SDL_UpdateTexture(main_data.maintext, NULL,
                       main_surface->pixels, main_surface->pitch);
