         }
       }
     }
@@ -898,6 +918,51 @@ widget_id gui_event_loop(void *data,
 /**********************************************************************//**
   Do any necessary pre-initialization of the UI, if necessary.
 **************************************************************************/
+#ifdef FREECIV_RISCOS
+/* Time spent waiting (SDL_Delay: other tasks, and the server, run) */
+static Uint64 riscos_idle_ticks = 0;
+
+/**********************************************************************//**
+  RISC OS: wait, polling the Wimp, and count the time as idle.
+**************************************************************************/
+static void riscos_idle_delay(Uint32 ms)
+{
+  Uint64 t0 = SDL_GetPerformanceCounter();
+
+  SDL_Delay(ms);
+  riscos_idle_ticks += SDL_GetPerformanceCounter() - t0;
+}
+
+/**********************************************************************//**
+  RISC OS: every 10 seconds, log how busy the client was and what showing
+  the picture cost (with Freeciv$Log set, in <Wimp$ScrapDir>.FreecivLog).
+**************************************************************************/
+static void riscos_log_stats(void)
+{
+  static Uint64 last = 0;
+  Uint64 now = SDL_GetPerformanceCounter();
+  Uint64 freq = SDL_GetPerformanceFrequency();
+
+  if (last == 0) {
+    last = now;
+    riscos_idle_ticks = 0;
+  } else if (now - last >= 10 * freq) {
+    Uint32 updates;
+    Uint64 pixels;
+    double ms;
+
+    direct_present_stats(&updates, &pixels, &ms);
+    log_verbose("RISC OS: in %.1f s, busy %.0f%%; %u screen updates, "
+                "%.1f Mpixels, %.0f ms",
+                (double) (now - last) / freq,
+                100.0 - 100.0 * riscos_idle_ticks / (now - last),
+                (unsigned) updates, pixels / 1e6, ms);
+    last = now;
+    riscos_idle_ticks = 0;
+  }
+}
+#endif /* FREECIV_RISCOS */
+
 #ifdef FREECIV_RISCOS
 /**********************************************************************//**
   RISC OS: fc_usleep() hook. SDL_Delay() polls the Wimp while it waits,
@@ -905,7 +970,7 @@ widget_id gui_event_loop(void *data,
 **************************************************************************/
 static void riscos_usleep(unsigned long usec)
 {
-  SDL_Delay((usec + 999) / 1000);
+  riscos_idle_delay((usec + 999) / 1000);
 }
 #endif /* FREECIV_RISCOS */
 
@@ -928,6 +993,52 @@ void ui_init(void)
   init_sdl(sdl_flags);
 }
 
+/**********************************************************************//**
+  The mouse wheel scrolls a list in the dialog under the pointer (dialogs
+  with the standard scroll buttons), or the map (a quarter of the view per
+  step; with Shift, or a sideways wheel, left and right) when the pointer
+  is over the map and not over a window or button. Upstream's SDL2 client
+  ignored the wheel.
+**************************************************************************/
+static void handle_mouse_wheel(const SDL_MouseWheelEvent *wheel)
+{
+  int x, y, dx, dy;
+
+  dx = wheel->x;
+  dy = -wheel->y;
+  if (wheel->direction == SDL_MOUSEWHEEL_FLIPPED) {
+    dx = -dx;
+    dy = -dy;
+  }
+
+  SDL_GetMouseState(&x, &y);
+
+  /* Over a dialog with a list: scroll the list, 2 rows a step */
+  if (dy != 0 && wheel_scroll_advanced_dialog(x, y, 2 * dy)) {
+    return;
+  }
+  if (find_next_widget_at_pos(NULL, x, y) != NULL) {
+    return;
+  }
+
+  /* Otherwise, over the map: scroll the map */
+  if (C_S_RUNNING != client_state() || get_client_page() != PAGE_GAME
+      || !can_client_change_view()) {
+    return;
+  }
+  if (SDL_GetModState() & KMOD_SHIFT) {
+    dx = dy;
+    dy = 0;
+  }
+  if (dx == 0 && dy == 0) {
+    return;
+  }
+
+  set_mapview_origin(mapview.gui_x0 + dx * mapview.width / 4,
+                     mapview.gui_y0 + dy * mapview.height / 4,
+                     map_zoom);
+}
+
 /**********************************************************************//**
   Really resize the main window.
 **************************************************************************/
@@ -968,6 +1079,19 @@ static void real_resize_window_callback(void *data)
 **************************************************************************/
 static void resize_window_callback(struct option *poption)
 {
+  /* Upstream only moved the widgets, so a new size took effect only after
+   * a restart. Resize the window and its surfaces now, as
+   * fullscreen_callback() does. */
+  if (!GUI_SDL_OPTION(fullscreen)) {
+    int w = GUI_SDL_OPTION(screen.width);
+    int h = GUI_SDL_OPTION(screen.height);
+
+    SDL_SetWindowSize(main_data.screen, w, h);
+    if (!create_surfaces(w, h)) {
+      log_error("Can't resize the window to %dx%d", w, h);
+    }
+  }
+
   update_queue_add(real_resize_window_callback, NULL);
 }
 
