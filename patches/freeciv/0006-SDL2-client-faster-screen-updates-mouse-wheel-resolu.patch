         }
 #endif
       }
     } else { /* If connection is not establish */
+#ifdef FREECIV_RISCOS
+      riscos_idle_delay(10);
+#else
       SDL_Delay(10);
+#endif
     }
+
+#ifdef FREECIV_RISCOS
+    riscos_log_stats();
+#endif
     /* ========================================= */
 
     t_current = SDL_GetTicks();
@@ -869,6 +885,10 @@ widget_id gui_event_loop(void *data,
             ID = mouse_motion_handler(&main_data.event.motion, data);
           }
           break;
+
+        case SDL_MOUSEWHEEL:
