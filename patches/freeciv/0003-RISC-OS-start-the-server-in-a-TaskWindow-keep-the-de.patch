+     * which the server's UnixLib expands when it opens files, so no
+     * quoting is needed. */
+    struct astring srv = ASTRING_INIT;
+    const char *wimpslot = getenv("FreecivServer$WimpSlot");
+    const char *appdir = getenv("Freeciv$Dir");
+
+    if (appdir == NULL || appdir[0] == '\0') {
+      log_error("Freeciv$Dir is not set: start Freeciv from its !Run file.");
+      output_window_append(ftc_client, _("Couldn't start the server."));
+
+      return FALSE;
+    }
+
+    fc_snprintf(savesdir, sizeof(savesdir), "%s" DIR_SEPARATOR "saves", storage);
+    fc_snprintf(scensdir, sizeof(scensdir), "%s" DIR_SEPARATOR "scenarios", storage);
+
+    astr_add(&srv, "%s.freeciv-server -p %d --bind localhost"
+             " -q 1 -e --saves %s --scenarios %s -A none",
+             appdir, internal_server_port, savesdir, scensdir);
+    if (logfile) {
+      astr_add(&srv, " --debug %s --log %s",
+               log_level_name(log_get_level()), logfile);
+    }
+    if (scriptfile) {
+      astr_add(&srv, " --read %s", scriptfile);
+    }
+    if (savefile) {
+      astr_add(&srv, " --file %s", savefile);
+    }
+    if (are_deprecation_warnings_enabled()) {
+      astr_add(&srv, " --warnings");
+    }
+    if (ruleset != NULL) {
