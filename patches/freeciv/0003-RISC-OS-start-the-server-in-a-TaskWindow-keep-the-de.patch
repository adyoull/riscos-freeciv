+#ifdef HAVE_CONFIG_H
+#include <fc_config.h>
+#endif
+
+#ifdef FREECIV_RISCOS
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <kernel.h>
+#include <swis.h>
+
+/* utility */
+#include "support.h"
+
+#include "fc_riscos.h"
+
+#ifndef Wimp_StartTask
+#define Wimp_StartTask                  0x400DE
+#endif
+#ifndef Wimp_SendMessage
+#define Wimp_SendMessage                0x400E7
+#endif
+#ifndef TaskManager_TaskNameFromHandle
+#define TaskManager_TaskNameFromHandle  0x42680
+#endif
+
+#define WIMP_USER_MESSAGE 17
+#define MESSAGE_QUIT      0
+
+/************************************************************************//**
+  Send stdout and stderr to the file named by 'var', or discard them.
+****************************************************************************/
+void fc_riscos_redirect_output(const char *var)
+{
+  const char *name = getenv(var);
+  FILE *f;
+
+  if (name == NULL || name[0] == '\0') {
+    name = "/dev/null";
+  }
+
+  /* Empty the file, then have both streams append to it, so neither
+   * writes over what the other has written. */
+  f = fopen(name, "w");
+  if (f != NULL) {
+    fclose(f);
+  } else {
+    name = "/dev/null";
+  }
+
+  if (freopen(name, "a", stdout) != NULL) {
+    setvbuf(stdout, NULL, _IOLBF, 0);
+  }
+  if (freopen(name, "a", stderr) != NULL) {
+    setvbuf(stderr, NULL, _IONBF, 0);
+  }
+}
+
+/************************************************************************//**
+  Start a new task.
+****************************************************************************/
+int fc_riscos_start_task(const char *command, char *errbuf, size_t errbuf_len)
+{
+  _kernel_oserror *err;
+  int task = 0;
+
+  err = _swix(Wimp_StartTask, _IN(0) | _OUT(0), command, &task);
+  if (err != NULL) {
+    fc_strlcpy(errbuf, err->errmess, errbuf_len);
+
+    return -1;
+  }
+
+  return task;
+}
+
+/************************************************************************//**
+  Is the task still running?
+****************************************************************************/
+bool fc_riscos_task_alive(int task)
+{
+  const char *name;
+
+  if (task == 0 || task == -1) {
+    return FALSE;
+  }
+
+  /* The Task Manager returns an error for handles that are not
+   * (or no longer) in use. */
+  return _swix(TaskManager_TaskNameFromHandle, _IN(0) | _OUT(0),
+               task, &name) == NULL;
+}
+
+/************************************************************************//**
+  Send Message_Quit to a task.
+****************************************************************************/
+void fc_riscos_quit_task(int task)
+{
+  int block[5];
+
+  if (!fc_riscos_task_alive(task)) {
+    return;
+  }
+
+  block[0] = sizeof(block);     /* size */
+  block[1] = 0;                 /* sender (filled in by the Wimp) */
+  block[2] = 0;                 /* my_ref */
+  block[3] = 0;                 /* your_ref */
+  block[4] = MESSAGE_QUIT;      /* action */
+  (void) _swix(Wimp_SendMessage, _INR(0, 2),
+               WIMP_USER_MESSAGE, block, task);
+}
+
+#endif /* FREECIV_RISCOS */
