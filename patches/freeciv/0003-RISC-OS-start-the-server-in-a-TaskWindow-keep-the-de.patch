+
+/* RISC OS support: things the other platforms get from the C library or
+ * the process model, done with RISC OS calls. Everything here is only
+ * compiled when FREECIV_RISCOS is defined. */
+
+#ifndef FC__FC_RISCOS_H
+#define FC__FC_RISCOS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif /* __cplusplus */
+
+/* utility */
+#include "support.h"            /* bool type */
+
+#ifdef FREECIV_RISCOS
+
+/* A program running in the desktop must not print: the first character
+ * written to stdout or stderr opens a command window. Send both streams
+ * to the file named by the system variable 'var' (a UnixLib path, e.g.
+ * set in !Run with "Set Freeciv$Output /|<Wimp$ScrapDir>/FreecivLog"),
+ * or discard them if it isn't set. Call first thing in main(). */
+void fc_riscos_redirect_output(const char *var);
+
+/* Start 'command' as a new task with Wimp_StartTask. The caller must be
+ * a Wimp task. Returns the new task's handle, 0 if it has already
+ * finished, or -1 on error (message in errbuf). */
+int fc_riscos_start_task(const char *command, char *errbuf, size_t errbuf_len);
+
+/* Is the task with this handle still running? */
+bool fc_riscos_task_alive(int task);
+
+/* Ask the task to quit (Message_Quit). A TaskWindow quits and kills the
+ * program in it. */
+void fc_riscos_quit_task(int task);
+
+#endif /* FREECIV_RISCOS */
+
+#ifdef __cplusplus
+}
+#endif /* __cplusplus */
+
+#endif /* FC__FC_RISCOS_H */
diff --git a/utility/support.c b/utility/support.c
index f43dd18..8c58e82 100644
--- a/utility/support.c
+++ b/utility/support.c
@@ -822,8 +822,30 @@ const char *fc_strerror(fc_errno err)
 /************************************************************************//**
   Suspend execution for the specified number of microseconds.
 ****************************************************************************/
+#ifdef FREECIV_RISCOS
+static void (*usleep_hook)(unsigned long usec) = NULL;
+
+/************************************************************************//**
+  RISC OS: have fc_usleep() call 'hook' instead. A desktop program must not
+  wait without calling Wimp_Poll, or every other task (including a server
+  started by the client) stops; the SDL client sets a hook that waits with
+  SDL_Delay(), which polls the Wimp.
+****************************************************************************/
+void fc_set_usleep_hook(void (*hook)(unsigned long usec))
+{
+  usleep_hook = hook;
+}
+#endif /* FREECIV_RISCOS */
+
 void fc_usleep(unsigned long usec)
 {
+#ifdef FREECIV_RISCOS
+  if (usleep_hook != NULL) {
+    usleep_hook(usec);
+    return;
+  }
+#endif /* FREECIV_RISCOS */
+
 #ifdef HAVE_NANOSLEEP
   struct timespec ts;
 
