   button_behavior.button_down_ticks = 0;
   button_behavior.hold_state = MB_HOLD_SHORT;
@@ -1008,8 +1040,20 @@ static void clear_double_messages_call(void)
   this in to function named SDL_main() and it provides actual main()
   itself.
 **************************************************************************/
+#ifdef FREECIV_RISCOS
+/* The C heap goes in a dynamic area with this name (UnixLib), so the
+ * WimpSlot only has to hold the program; removed when the client quits. */
+const char * const __dynamic_da_name = "Freeciv Heap";
+int __dynamic_da_max_size = 256 * 1024 * 1024;
+#endif /* FREECIV_RISCOS */
+
 int main(int argc, char **argv)
 {
+#ifdef FREECIV_RISCOS
+  /* Printing from a desktop program would open a command window */
+  fc_riscos_redirect_output("Freeciv$Output");
+#endif
+
   return client_main(argc, argv, FALSE);
